class Solution {
    static boolean isPrime(int n) {
        // code here
        if(n==0 || n == 1) {
            return false;
        }
        int x = 2;
        while(x*x<= n) { 
            if(n%x == 0) {
                return false;
            }
            x++;
        }
        return true;
    }
}
