class Solution {
    static int findFloor(int[] arr, int x) {

        int left = 0, right = arr.length - 1;
        int ans = -1;

        while (left <= right) {

            int mid = left + (right - left) / 2;

            if (arr[mid] <= x) {
                ans = mid;
                left = mid + 1; // maybe a larger valid value exists on the right
            }
            else {
                right = mid - 1;
            }
        }

        return ans;
    }
}
