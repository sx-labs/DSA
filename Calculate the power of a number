public class Main {
    public static void main(String[] args) {
        int base = 3;
        int exponent = 4;
        long result = 1; // Stores the final value

        // Multiply the result by the base, exponent times
        for (int i = 0; i < exponent; i++) {
            result *= base;
        }

        System.out.println(base + "^" + exponent + " = " + result);
    }
}
