
class Solution {
    public ListNode sortList(ListNode head) {
        if(head == null || head.next == null) return head;//if single node so it is already sorted
        ListNode zero = new ListNode(-1);
        ListNode one = new ListNode(-1);
        ListNode two = new ListNode(-1);

        ListNode z = zero, o = one, t = two;

        while (head != null) {
            if (head.val == 0) {
                z.next = head;
                z = z.next;
            }
            else if (head.val == 1) {
                o.next = head;
                o = o.next;
            }
            else {
                t.next = head;
                t = t.next;
            }
            head = head.next;
        }

        z.next = one.next != null ? one.next : two.next;
        o.next = two.next;
        t.next = null;

        return zero.next;
    }
}

//Bruteforce
class Solution {
    public ListNode sortList(ListNode head) {
        int count = 0, count1 = 0, count2 = 0;
        ListNode temp = head;

        while (temp != null) {
            if (temp.val == 0) count++;
            else if (temp.val == 1) count1++;
            else count2++;

            temp = temp.next;
        }

        temp = head;

        while (temp != null) {
            if (count > 0) {
                temp.val = 0;
                count--;
            }
            else if (count1 > 0) {
                temp.val = 1;
                count1--;
            }
            else {
                temp.val = 2;
                count2--;
            }
            temp = temp.next;
        }

        return head;
    }
}
