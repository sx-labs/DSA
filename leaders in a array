class Solution {
    public List<Integer> leaders(int[] nums) {
       List<Integer> l = new ArrayList<>();
       for(int i = 0 ; i <nums.length ; i++) {
            for(int j = i+1 ; j<nums.length ; j++ ) {
        
                if(nums[j]>=nums[i]) {
                    break;
                }
                else {
                    if(j == nums.length-1) {
                        l.add(nums[i]);
                        break;
                    }
                    continue;
                    }
               
            } //j loop finsih
            if(i == nums.length-1) {
                l.add(nums[i]);
            }
       }
       return l;
    }
}
   
