 class Solution {
     public int findLengthOfLoop(ListNode head) {
        int count =1; //because when the pointers collide, we are already standing on the first node of the cycle traversal. We count that node as 1, then move fast forward and count the remaining nodes.
        ListNode slow = head;
        ListNode fast = head;
        while(fast!= null && fast.next!= null) {
            slow = slow.next;
            fast = fast.next.next;
            if(slow == fast) {
                fast = fast.next;
                while(slow  != fast) {
                    fast = fast.next;
                    count++;
                }
                return count;
            }
        }
        return 0;
     }
 }

import java.util.HashMap;

class Solution {
    public int findLengthOfLoop(ListNode head) {

        HashMap<ListNode, Integer> map = new HashMap<>();

        ListNode temp = head;
        int count = 0;

        while (temp != null) {

            if (map.containsKey(temp)) {
                int firstVisit = map.get(temp);
                return count - firstVisit;
            }

            map.put(temp, count);

            count++; //The reason is that we want count to represent the number of steps taken before reaching the current node again, not include an extra step.
            temp = temp.next;
        }

        return 0;
    }
}
