class Solution {

    int countFreq(int[] arr, int target) {

        int first = findFirst(arr, target);
        int last = findLast(arr, target);

        // Target does not exist
/* The answer comes from an important property of a sorted array. No. last means last occurrence of the target 4. 
If there is no 4 anywhere, there cannot be a last occurrence of 4.
*/
        if (first == -1) {
            return 0;
        }

        return last - first + 1;
    }

    public int findFirst(int[] arr, int target) {

        int left = 0;
        int right = arr.length - 1;
        int ans = -1;

        while (left <= right) {

            int mid = left + (right - left) / 2;

            if (arr[mid] == target) {
                ans = mid;
                right = mid - 1;   // search further left
            }
            else if (arr[mid] < target) {
                left = mid + 1;
            }
            else {
                right = mid - 1;
            }
        }

        return ans;
    }

    public int findLast(int[] arr, int target) {

        int left = 0;
        int right = arr.length - 1;
        int ans = -1;

        while (left <= right) {

            int mid = left + (right - left) / 2;

            if (arr[mid] == target) {
                ans = mid;
                left = mid + 1;    // search further right
            }
            else if (arr[mid] < target) {
                left = mid + 1;
            }
            else {
                right = mid - 1;
            }
        }

        return ans;
    }
}
