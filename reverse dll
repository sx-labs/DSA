class Solution {
    public ListNode reverseDLL(ListNode head) {
        // Your code goes here
        ListNode curr = head;
        ListNode prev = null;
        ListNode next = null;

        while(curr != null) {
            next = curr.next;
            curr.next = prev;
            curr.prev = next;

            prev = curr;
            curr = next;
        }
        head = prev;
        return head;
    }
}
