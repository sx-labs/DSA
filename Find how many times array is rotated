class Solution {
    public int findKRotation(ArrayList<Integer> nums) {
        int low = 0;
        int high= nums.size() -1;
        while(low< high) {
            int mid = low + (high - low)/2;
            if(nums.get(mid)< nums.get(high)) {
                high = mid;
            }
            else {
                low = mid+1;
            }
        }
        return low;
    }
}
NOTE - 
The minimum element is at mid + 1.
